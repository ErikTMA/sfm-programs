name "Sieve the world - Consolidated"

every 20 ticks do
    -- Input from hammer input chest and distribute to hammers
    input from Input_Hammer
    output retain 20 each to each Hammers
end

every 20 ticks do
    -- Input from sieve input chest and distribute to sieves
    input from Input_Sieve
    output retain 20 each to each Sieves
end

every 20 ticks do
    -- Collect from dedicated output chests of sieves and hammers
    input from Sieves_Output_Chest, Hammers_Output_Chest
    
    -- Priority-based output to compactors (fill first, then next, etc.)
    output *chunk*, *pebble* to Compactors_Input
    
    -- Other materials go directly to output
    output * to Output_Chest
end

every 20 ticks do
    input from Compactors_Input
    output * to Compactors
end

every 20 ticks do
    -- Process compactors with priority system
    -- Collect from dedicated output chests of compactors
    input from Compactors_Output_Chest
    
    -- Output processed materials to main output chest
    output * to Output_Chest
end

every 1 ticks do
    -- Power distribution to all machines
    input fe:: from Power_Input east side
    output fe:: to each Hammers, Sieves, Compactors
end
